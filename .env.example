# Docker Environment Configuration Example
# Copy this file to .env and fill in your values

# === REQUIRED ===
# Cursor API key (required for v2.0+)
# Get it from: https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=cursor_your_api_key_here

# === OPTIONAL: Server Configuration ===

# Proxy port (default: 8765)
CURSOR_BRIDGE_PORT=8765

# Bind address (default: 0.0.0.0 for container)
CURSOR_BRIDGE_HOST=0.0.0.0

# === OPTIONAL: Authentication ===

# API key for client authentication (if set, clients must include Authorization header)
# If unset, any client can connect (recommended for local networks only)
# CURSOR_BRIDGE_API_KEY=your-secret-key

# === OPTIONAL: Model Settings ===

# Default model (default: auto)
CURSOR_BRIDGE_DEFAULT_MODEL=auto

# Use strict model resolution (default: true)
# When true, uses last requested model if none specified
CURSOR_BRIDGE_STRICT_MODEL=true

# === OPTIONAL: Workspace & Execution ===

# Workspace directory (default: /app)
CURSOR_BRIDGE_WORKSPACE=/app/workspace

# Chat-only workspace (default: true)
# When true, runs in temp dir (no file operations)
# When false, uses real workspace for file operations
CURSOR_BRIDGE_CHAT_ONLY_WORKSPACE=true

# === OPTIONAL: Performance ===

# Timeout per completion in milliseconds (default: 300000 = 5 minutes)
CURSOR_BRIDGE_TIMEOUT_MS=300000

# === OPTIONAL: Logging ===

# Enable verbose logging (default: false)
# When true, logs full request/response content
CURSOR_BRIDGE_VERBOSE=false

# === OPTIONAL: Runtime (Under Development) ===

# Use cloud runtime (default: false - uses local)
# CURSOR_BRIDGE_USE_CLOUD_RUNTIME=false